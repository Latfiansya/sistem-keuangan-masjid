PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Prefix path API; ubah bila aplikasi berjalan di dalam subdirectory.
API_BASE_PATH=/api
# Batas aman ukuran payload JSON per request sesuai SOP Capstone.
JSON_BODY_LIMIT=10kb
# Pembatasan percobaan brute force pada endpoint sandi laporan.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
# Hash scrypt sandi akses bersama laporan (tanpa menyimpan sandi plaintext di repositori).
# Buat hash di folder backend dengan:
# node -e "import('./src/utils/passwordHash.js').then(m => console.log(m.hashPassword('ganti-sandi')))"
REPORT_SHARED_PASSWORD_HASH=

# Konfigurasi CORS dan autentikasi pengurus
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ADMIN_AUTH_REQUIRED=false
# Rahasia penandatanganan token sesi admin (wajib minimal 32 karakter; buat acak di .env lokal/server)
AUTH_SECRET=

# Konfigurasi koneksi PostgreSQL (gunakan DATABASE_URL atau parameter DB_*)
DATABASE_URL=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=keuangan_masjid
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer
